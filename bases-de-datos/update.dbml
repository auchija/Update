}

Table solicitudes_mentoria {
  id uuid [pk, default: `gen_random_uuid()`]
  oferta_id uuid [not null]
  perfil_mentoreado_id uuid [not null]
  creado_por_usuario_id uuid [not null]
  mensaje text [not null]
