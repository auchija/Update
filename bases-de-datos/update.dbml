  indexes {
    (usuario_seguidor_id, perfil_seguido_id) [pk]
  }
}

Table sesiones {
  id uuid [pk, default: `gen_random_uuid()`]
  usuario_id uuid [not null]
  hash_token_refresco text [not null, unique]
  familia_id uuid [not null]
  reemplazado_por_id uuid
  agente_usuario text
  direccion_ip inet
