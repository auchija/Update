# Variables de entorno del frontend.
# Copia este archivo como .env y ajusta los valores. El archivo .env NO se sube a Git.
# En Vite, solo las variables que empiezan por VITE_ llegan al navegador:
# nunca pongas contraseñas ni secretos aquí.

# URL del backend (Railway), sin "/" al final.
VITE_API_URL=http://localhost:4000/api

# true  → login y registro usan los usuarios de prueba (src/data/users.js). No necesita backend.
# false → llaman al backend real en VITE_API_URL.
VITE_USE_MOCKS=true
