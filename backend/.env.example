# Variables de entorno de la API. En producción (Render) se ponen en el panel del servicio;
# con Docker en local: copia este archivo como backend/.env y usa  docker run --env-file backend/.env ...
# Para correr con  dotnet run  se usan user-secrets (ver backend/README.md). Nunca subas valores reales.

# PostgreSQL de Supabase: Project Settings > Database > Connection string (.NET), con la contraseña de la base.
ConnectionStrings__DefaultConnection=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<proyecto>;Password=<contraseña>

# Clave para firmar las sesiones: al menos 32 caracteres al azar.
Jwt__Clave=<clave-larga-al-azar>

# Supabase Storage: Project Settings > API. La service_role key es secreta y solo va en el servidor.
Supabase__Url=https://<proyecto>.supabase.co
Supabase__Bucket=archivos
Supabase__ServiceRoleKey=<service-role-key>

# Página web que puede llamar a la API (la de Vercel). Para más de una: Cors__Origenes__1, __2...
Cors__Origenes__0=https://<tu-proyecto>.vercel.app

# Swagger en producción (en /swagger). Ponlo en false si no lo quieres público.
Swagger__Habilitado=true
